<Window x:Class="Rock_Paper_Scissors.Start"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rock_Paper_Scissors"
        mc:Ignorable="d"
        Title="Start" Height="450" Width="800" Icon="RockPaperScissors.png">
  <Grid>
    <Image HorizontalAlignment="Left" Height="220" Margin="230,40,0,0" VerticalAlignment="Top" Width="390" Source="Images/startImage.jpg"/>
    <Button Cursor="Hand" x:Name="btnStart" Click="btnStart_Click" Content="Start" HorizontalAlignment="Left" Margin="320,300,0,0" VerticalAlignment="Top" Width="225" Height="85" FontSize="50" Background="LightBlue"/>
  </Grid>
</Window>
