<Window x:Class="Rock_Paper_Scissors.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rock_Paper_Scissors"
        mc:Ignorable="d"
        Title="Rock Paper Scissors" Height="450" Width="800" Icon="RockPaperScissors.png">
  <Grid>
    <Button x:Name="btnRock" Cursor="Hand" HorizontalAlignment="Left" Margin="40,106,0,0" VerticalAlignment="Top" Width="100" Click="btnRock_Click" Height="42">
      <StackPanel Orientation="Horizontal">
        <Image Source="/Rock Paper Scissors;component/Images/rock.png" Height="40" Width="23" RenderTransformOrigin="0.5,0.5" >
          <Image.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="-1"/>
              <SkewTransform/>
              <RotateTransform/>
              <TranslateTransform/>
            </TransformGroup>
          </Image.RenderTransform>
        </Image>
        <TextBlock Margin="5,0" Height="20" FontWeight="Bold"><Run Text="Rock"/></TextBlock>
      </StackPanel>
    </Button>
    <Button x:Name="btnPaper" Cursor="Hand" HorizontalAlignment="Left" Margin="40,208,0,0" VerticalAlignment="Top" Width="100" Click="btnPaper_Click" Height="42">
      <StackPanel Orientation="Horizontal">
        <Image Source="/Rock Paper Scissors;component/Images/paper.png" Height="40" Width="23" RenderTransformOrigin="0.5,0.5" >
          <Image.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="-1"/>
              <SkewTransform/>
              <RotateTransform/>
              <TranslateTransform/>
            </TransformGroup>
          </Image.RenderTransform>
        </Image>
        <TextBlock Margin="5,0" Height="20" FontWeight="Bold"><Run Text="Paper"/></TextBlock>
      </StackPanel>
    </Button>
    <Button x:Name="btnScissor" Cursor="Hand" HorizontalAlignment="Left" Margin="40,308,0,0" VerticalAlignment="Top" Width="100" Click="btnScissor_Click" Height="42">
      <StackPanel Orientation="Horizontal">
        <Image Source="/Rock Paper Scissors;component/Images/scissor.png" Height="40" Width="23" RenderTransformOrigin="0.5,0.5" >
          <Image.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="-1"/>
              <SkewTransform/>
              <RotateTransform/>
              <TranslateTransform/>
            </TransformGroup>
          </Image.RenderTransform>
        </Image>
        <TextBlock Margin="5,0" Height="20" FontWeight="Bold"><Run Text="Scissor"/></TextBlock>
      </StackPanel>
    </Button>
    <Label FontSize="25" Foreground="Blue" x:Name="lblResult" Content="" HorizontalAlignment="Left" Margin="303,334,0,0" VerticalAlignment="Top" RenderTransformOrigin="5.526,0.385"/>
    <Label Content="VS" HorizontalAlignment="Left" Margin="445,203,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.25,0.192" FontSize="30"/>
    <Label Content="Endscheidung des Benutzers:" HorizontalAlignment="Left" Margin="186,97,0,0" VerticalAlignment="Top" FontSize="15" Foreground="Blue"/>
    <Label Content="Endscheidung des Computers:" HorizontalAlignment="Left" Margin="570,97,0,0" VerticalAlignment="Top" FontSize="15" Foreground="Red"/>
    <Label x:Name="lblPunkteUser" Content="" HorizontalAlignment="Left" Margin="422,44,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.947,0.192" Foreground="Blue"/>
    <Label Content=":" HorizontalAlignment="Left" Margin="463,44,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
    <Label x:Name="lblPunkteComputer" Content="" HorizontalAlignment="Left" Margin="502,44,0,0" VerticalAlignment="Top" Foreground="Red"/>
    <Label Content="Punktestand" HorizontalAlignment="Left" Margin="420,10,0,0" VerticalAlignment="Top" FontSize="15" FontWeight="Bold"/>
    <Image x:Name="Endscheidung_User" HorizontalAlignment="Left" Height="146" Margin="217,158,0,0" VerticalAlignment="Top" Width="146"/>
    <Image x:Name="Endscheidung_Computer" HorizontalAlignment="Left" Height="146" Margin="604,155,0,0" VerticalAlignment="Top" Width="146"/>
  </Grid>
</Window>
